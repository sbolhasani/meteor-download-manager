<Window x:Class="Nexonic.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nexonic.App"
        Title="Meteor Download Manager" Width="1100" Height="620" MinWidth="760" MinHeight="420"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <!-- Search already has its outer border: do not use theme-specific TextBox borders or focus rings. -->
    <Style x:Key="SearchTextBoxStyle" TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                          Focusable="False" Margin="0"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- This style is always used for sidebar rows so theme templates cannot drop hierarchy indentation. -->
    <Style x:Key="SidebarEntryStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="SidebarRow" Background="{TemplateBinding Background}" MinHeight="{TemplateBinding MinHeight}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SidebarRow" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="SidebarRow" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
    <Style x:Key="ToolButton" TargetType="Button">
      <!-- Shared toolbar dimensions are applied by MainWindow for every theme. -->
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="0,1,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Foreground="{DynamicResource TextBrush}" Padding="4,2">
      <MenuItem Header="_Tasks">
        <MenuItem Header="_Add URL…" InputGestureText="Ctrl+N" Click="OnAdd" />
        <MenuItem Header="Add _Torrent…" InputGestureText="Ctrl+Shift+T" Click="OnTorrents" />
        <MenuItem Header="Add _Batch Download…" InputGestureText="Ctrl+Shift+B" Click="OnBatch" />
        <MenuItem Header="Site _Grabber…" InputGestureText="Ctrl+Shift+G" Click="OnGrabber" />
        <MenuItem Header="Add _Playlist or Channel…" InputGestureText="Ctrl+Shift+L" Click="OnPlaylist" />
        <Separator />
        <MenuItem Header="_Options…" Click="OnSettings" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" InputGestureText="Ctrl+R" Click="OnResume" />
        <MenuItem Header="_Stop" InputGestureText="Ctrl+." Click="OnPause" />
        <Separator />
        <MenuItem Header="Resume _All" InputGestureText="Ctrl+Shift+R" Click="OnResumeAll" />
        <MenuItem Header="Stop A_ll" InputGestureText="Ctrl+Shift+P" Click="OnPauseAll" />
        <Separator />
        <MenuItem Header="_Open" InputGestureText="Ctrl+O" Click="OnOpen" />
        <MenuItem Header="Show in _Folder" Click="OnShowInFolder" />
        <MenuItem Header="_Properties…" InputGestureText="Ctrl+I" Click="OnProperties" />
        <Separator />
        <MenuItem Header="_Delete…" InputGestureText="Del" Click="OnRemove" />
        <MenuItem Header="Delete _Completed…" Click="OnClear" />
        <Separator />
        <MenuItem x:Name="UnzipItem" Header="_Unzip Finished .zip Files" IsCheckable="True" Click="OnToggleUnzip"
                  ToolTip="Unpack each finished .zip download into a folder next to it" />
        <MenuItem x:Name="SubtitlesItem" Header="Save Su_btitles With Videos" IsCheckable="True" Click="OnToggleSubtitles"
                  ToolTip="Videos keep subtitles in your language and English when the site has them" />
        <MenuItem Header="_Media Library…" InputGestureText="Ctrl+L" Click="OnLibrary" />
        <Separator />
        <MenuItem Header="S_cheduler…" Click="OnScheduler" />
        <MenuItem Header="Start _Queue" Click="OnStartQueue" />
        <MenuItem Header="Stop Q_ueue" Click="OnStopQueue" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem x:Name="ShowToolbarItem" Header="Show _Toolbar Buttons" IsCheckable="True" Click="OnToggleToolbar" />
        <MenuItem x:Name="ShowNamesItem" Header="Show Button _Names" IsCheckable="True" Click="OnToggleNames" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Help" InputGestureText="F1" Click="OnHelp" />
        <MenuItem Header="_About Meteor Download Manager" Click="OnAbout" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,0,1" Padding="6,3">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Margin="8,0,4,0" Width="200" Height="28" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="Search" Style="{StaticResource SearchTextBoxStyle}" BorderThickness="0" Background="Transparent" Margin="28,0,6,0" VerticalContentAlignment="Center" TextChanged="OnSearch" ToolTip="Search downloads (Ctrl+F)" />
            <TextBlock x:Name="SearchHint" Text="Search downloads" Foreground="{DynamicResource MutedBrush}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
        <Grid x:Name="ToolbarHost" ClipToBounds="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="Toolbar" Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Left">
        <Button Style="{StaticResource ToolButton}" Click="OnAdd" ToolTip="Add one or more links (Ctrl+N)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#2DA44E" Text="&#xE710;" /><TextBlock Style="{StaticResource Caption}" Text="Add URL" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnTorrents" ToolTip="Torrent Manager: add a .torrent file, torrent link or magnet">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#6E40C9" Text="&#xE896;" /><TextBlock Style="{StaticResource Caption}" Text="Torrents" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource BorderBrushTheme}" Margin="6,0" VerticalAlignment="Center" />
        <Button x:Name="ResumeButton" Style="{StaticResource ToolButton}" Click="OnResume" ToolTip="Resume the selected downloads (Ctrl+R)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#1F6FEB" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Resume" /></StackPanel>
        </Button>
        <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Click="OnPause" ToolTip="Stop the selected downloads">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#D97706" Text="&#xE769;" /><TextBlock Style="{StaticResource Caption}" Text="Stop" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnPauseAll" ToolTip="Stop every download">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#CF222E" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop All" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource BorderBrushTheme}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnSelectAll" ToolTip="Select every download in this list (click again to deselect)">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#0E9F9F" Text="&#xE762;" /><TextBlock Style="{StaticResource Caption}" Text="Select All" /></StackPanel>
        </Button>
        <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="OnRemove" ToolTip="Remove the selected downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#CF222E" Text="&#xE74D;" /><TextBlock Style="{StaticResource Caption}" Text="Delete" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnClear" ToolTip="Remove finished downloads from the list">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#2DA44E" Text="&#xE73E;" /><TextBlock Style="{StaticResource Caption}" Text="Delete Completed" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource BorderBrushTheme}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnScheduler" ToolTip="Queues and timetables">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#8250DF" Text="&#xE787;" /><TextBlock Style="{StaticResource Caption}" Text="Scheduler" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStartQueue" ToolTip="Start the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#10B981" Text="&#xE768;" /><TextBlock Style="{StaticResource Caption}" Text="Start Queue" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnStopQueue" ToolTip="Stop the selected queue">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#DB2777" Text="&#xE71A;" /><TextBlock Style="{StaticResource Caption}" Text="Stop Queue" /></StackPanel>
        </Button>
        <Border Width="1" Height="36" Background="{DynamicResource BorderBrushTheme}" Margin="6,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource ToolButton}" Click="OnGrabber" ToolTip="Download files from a website section">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#1F6FEB" Text="&#xE774;" /><TextBlock Style="{StaticResource Caption}" Text="Grabber" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnBatch" ToolTip="Download a numbered series of files">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#9A6700" Text="&#xE8FD;" /><TextBlock Style="{StaticResource Caption}" Text="Batch" /></StackPanel>
        </Button>
        <Button Style="{StaticResource ToolButton}" Click="OnSettings" ToolTip="Options">
          <StackPanel><TextBlock Style="{StaticResource Glyph}" Foreground="#6E7781" Text="&#xE713;" /><TextBlock Style="{StaticResource Caption}" Text="Options" /></StackPanel>
        </Button>
          </StackPanel>
          <Button x:Name="ToolbarOverflowButton" Grid.Column="1" Visibility="Collapsed"
                  Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                  ToolTip="More toolbar actions" Width="33" MinHeight="36"
                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" Margin="3,0,0,0"
                  VerticalAlignment="Center" Click="OnToolbarOverflow" />
        </Grid>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
        <TextBlock x:Name="StatusLeft" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="265" MinWidth="230" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Sidebar" Grid.Column="0" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SidebarBrush}" BorderThickness="0" SelectionChanged="OnFilter" Padding="0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushTheme}" />
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                  MouseDoubleClick="OnRowDoubleClick" SelectionChanged="OnSelection" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderThickness="0" RowHeight="30" CanUserReorderColumns="True" CanUserSortColumns="True"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrushTheme}" GridLinesVisibility="Horizontal">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OnOpen" />
              <MenuItem Header="Show in Folder" Click="OnShowInFolder" />
              <MenuItem Header="Show Progress" Click="OnShowProgress" />
              <Separator />
              <MenuItem Header="Resume" Click="OnResume" />
              <MenuItem Header="Stop" Click="OnPause" />
              <MenuItem Header="Refresh Link…" Click="OnRefreshLink" />
              <MenuItem Header="Properties…" Click="OnProperties" />
              <MenuItem Header="Copy Link" Click="OnCopyLink" />
              <MenuItem Header="Show QR Code…" Click="OnShowQr" />
              <MenuItem x:Name="MoveMenu" Header="Move to Queue" />
              <Separator />
              <MenuItem Header="Delete…" Click="OnRemove" />
              <MenuItem Header="Delete and Move File to Recycle Bin…" Click="OnRemoveFile" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="File Name" Width="*" MinWidth="230" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon, Mode=OneWay}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
            <DataGridTemplateColumn Header="Progress" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="10" Margin="4,0" Foreground="{DynamicResource AccentBrush}" /></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80" />
            <DataGridTextColumn Header="Time Left" Binding="{Binding TimeLeft}" Width="70" />
            <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush, Mode=OneWay}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status, Mode=OneWay}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Queue" Binding="{Binding Queue}" Width="90" />
            <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="Empty" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
          <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyTitle" Text="No downloads here yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,6" />
          <TextBlock Text="Click Add URL, paste a link, drop one on this window, or download from your browser with the extension." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          <Button Content="Add URL" Click="OnAdd" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="18,6" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
        <Border x:Name="Details" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,1,0,0" Padding="12,8" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="DetailName" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="DetailUrl" Style="{StaticResource SearchTextBoxStyle}" IsReadOnly="True" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" FontSize="11" Background="Transparent" />
            <local:SegmentBar x:Name="Bar" Height="14" Margin="0,6" />
            <TextBlock x:Name="DetailInfo" Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock x:Name="DetailError" FontSize="11" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
